{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "jsx": "react-jsx",
    "allowJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "paths": {
      // `@/*` is the SPA workspace's own alias (apps/frontend/tsconfig.json
      // and its Vite config). It is repeated here so an editor that picks up
      // the root config still resolves it.
      "@/*": ["./apps/frontend/src/*"]
    }
  },
  // The two TypeScript projects in this repo are apps/frontend and e2e, each
  // with its own tsconfig; `bun run typecheck` runs both. This root config is
  // the base they extend and the fallback an editor uses, so it points at the
  // SPA sources rather than compiling a third, overlapping project.
  "include": [
    "apps/frontend/src/**/*.ts",
    "apps/frontend/src/**/*.tsx",
    "apps/frontend/src/**/*.d.ts",
    "apps/frontend/test/**/*.ts",
    "apps/frontend/test/**/*.tsx",
    "apps/frontend/vite.config.ts",
    "apps/frontend/vitest.config.ts"
  ]
}
