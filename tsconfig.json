{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "jsx": "react-jsx",
    "allowJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types",
      "node",
      "vitest/globals"
    ],
    "paths": {
      // `@/*` is the SPA workspace's own alias (apps/frontend/tsconfig.json
      // and both of its Vite configs). It is repeated here because the root
      // `tsc --noEmit` and the root Vitest run both still compile
      // apps/frontend's sources and tests.
      "@/*": ["./apps/frontend/src/*"],
      "@client/*": ["./apps/frontend/src/*"],
      "@server/*": ["./src/server/*"],
      "@test/*": ["./test/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "test/**/*.ts",
    "test/**/*.tsx",
    "apps/frontend/src/**/*.ts",
    "apps/frontend/src/**/*.tsx",
    "apps/frontend/src/**/*.d.ts",
    "apps/frontend/test/**/*.ts",
    "apps/frontend/test/**/*.tsx",
    "apps/frontend/vite.config.ts",
    "apps/frontend/vitest.config.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
