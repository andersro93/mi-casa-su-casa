{
  "name": "mi-casa-su-casa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare-native shared verification inbox for families.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run build:client",
    "build:client": "vite build",
    "check": "biome check .",
    "db:apply:local": "wrangler d1 migrations apply mi-casa-su-casa --local",
    "db:apply:remote": "wrangler d1 migrations apply mi-casa-su-casa --remote",
    "dev": "concurrently -k \"vite build --watch\" \"wrangler dev --test-scheduled\"",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "ci": "npm run check && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "better-auth": "1.6.10",
    "hono": "4.12.18",
    "postal-mime": "2.7.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@cloudflare/vite-plugin": "1.36.3",
    "@cloudflare/workers-types": "4.20260509.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "concurrently": "9.2.1",
    "typescript": "6.0.3",
    "vite": "8.0.11",
    "vitest": "4.1.5",
    "wrangler": "4.90.0"
  }
}
